<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_library_book_report_wizard_form" model="ir.ui.view">
        <field name="name">library.book.report.wizard.form</field>
        <field name="model">library.book.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Book List Excel Report">
                <sheet>
                    <group>
                        <field name="category_ids" widget="many2many_tags"/>
                        <field name="from_date"/>
                        <field name="to_date"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Export Excel"
                            name="action_export_excel"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_library_book_report_wizard" model="ir.actions.act_window">
        <field name="name">Book List Excel Report</field>
        <field name="res_model">library.book.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'active_model':'library.book'}</field>
    </record>
</odoo>
<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_library_borrow_list" model="ir.ui.view">
        <field name="name">library.borrow.list</field>
        <field name="model">library.borrow</field>
        <field name="arch" type="xml">
            <list string="Borrows">
                <field name="name"/>
                <field name="member_id"/>
                <field name="book_id"/>
                <field name="borrow_date"/>
                <field name="due_date"/>
                <field name="state"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_library_borrow_form" model="ir.ui.view">
        <field name="name">library.borrow.form</field>
        <field name="model">library.borrow</field>
        <field name="arch" type="xml">
            <form string="Borrow Record">
                <header>
                    <button string="Borrow"
                            name="action_borrow"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Return"
                            name="action_return"
                            type="object"
                            class="btn-success"
                            invisible="state != 'borrowed'"/>
                    <button string="Cancel"
                            name="action_cancel"
                            type="object"
                            class="btn-danger"
                            invisible="state not in ['draft','borrowed']"/>
                    <button string="Print Receipt"
                            name="%(action_report_borrow_receipt)d"
                            type="action"
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="member_id"
                               domain="[('is_library_member','=',True)]"/>
                        <field name="book_id"/>
                        <field name="borrow_date"/>
                        <field name="due_date"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_library_borrow" model="ir.actions.act_window">
        <field name="name">Borrow Records</field>
        <field name="res_model">library.borrow</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
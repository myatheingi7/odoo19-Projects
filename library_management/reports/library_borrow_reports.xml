<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_report_borrow_receipt" model="ir.actions.report">
        <field name="name">Borrowing Receipt</field>
        <field name="model">library.borrow</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">library_management.report_borrow_receipt</field>
        <field name="print_report_name">'Borrowing_Receipt_%s' % (object.name or str(object.id))</field>
    </record>

    <template id="report_borrow_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Borrowing Receipt</h2>
                        <p><strong>Member:</strong> <span t-field="doc.member_id"/></p>
                        <p><strong>Book:</strong> <span t-field="doc.book_id"/></p>
                        <p><strong>Borrow Date:</strong> <span t-field="doc.borrow_date"/></p>
                        <p><strong>Due Date:</strong> <span t-field="doc.due_date"/></p>
                        <p><strong>Status:</strong> <span t-field="doc.state"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>